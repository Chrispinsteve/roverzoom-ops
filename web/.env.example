# RoverZoom Ops — console (browser) configuration.
#
# Copy to web/.env. Everything here ships INSIDE the built bundle, so only
# public values belong in this file. The service-role key must never appear.

# Same Supabase project as the rider/driver app. The anon key is public by
# design and is constrained entirely by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the ops API lives. Leave EMPTY in development — vite proxies /api to
# localhost:4100. In production set it to the deployed API origin, e.g.
# https://ops-api.roverzoom.com
VITE_API_URL=

# Pickup times are shown in the service timezone, not the operator's browser
# timezone, so a dispatcher working remotely still reads Florida time.
VITE_SERVICE_TZ=America/New_York
