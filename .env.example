# RoverZoom Ops — API configuration.
#
# Copy to .env (repo root) or server/.env — both are loaded, server/ wins.
# NEVER commit the filled-in file. Both paths are gitignored.

# ---------------------------------------------------------------------------
# Supabase — the SAME project the rider/driver app uses.
# ---------------------------------------------------------------------------
# The service_role key bypasses Row Level Security, which the console requires:
# it reads across every driver and booking, and no RLS policy in the rider/
# driver schema allows that. This key must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# First admin (bootstrap)  ** REQUIRED TO SIGN IN THE FIRST TIME **
# ---------------------------------------------------------------------------
# The first owner cannot be granted by an existing admin, because there isn't
# one. Set this to your own Supabase Auth email and you are treated as an
# owner even with no role in app_metadata.
#
# Leave EMPTY to disable. Unset means "no bootstrap", never "everyone is an
# owner" — the auth path fails closed. But note: with NO admin role set on any
# account and this empty, nobody can sign in at all.
#
# Once you are in: grant yourself a real role, then clear this.
ADMIN_BOOTSTRAP_EMAIL=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Only needed if the console is served from a DIFFERENT origin than this API.
# On the bundled Vercel deploy they share an origin, so this can stay empty.
# Empty allows ALL origins (fine locally, never in production on a split host).
# e.g. https://admin.roverzoom.com
CORS_ORIGINS=

PORT=4100

# ---------------------------------------------------------------------------
# Domain model — MUST match the rider/driver backend exactly.
# ---------------------------------------------------------------------------
# The console reports what drivers are owed. If these drift from the values in
# roverzoom/backend/.env, it will report confident, wrong money.
# Run `npm run verify:sync -- /path/to/roverzoom` after changing either side.
DRIVER_CUT_PCT=0.575
FARE_MULTIPLIER_MORNING=0.75
FARE_MULTIPLIER=0.85
SERVICE_TZ=America/New_York

# ---------------------------------------------------------------------------
# Driver identity documents
# ---------------------------------------------------------------------------
# Storage buckets, mirrored from UPLOAD_BUCKETS in the rider/driver backend.
# driver-photos is PUBLIC; driver-documents is PRIVATE, which is why the
# licence and insurance are served as short-lived signed URLs.
DRIVER_PHOTO_BUCKET=driver-photos
DRIVER_DOCS_BUCKET=driver-documents

# How long a signed document URL stays valid, in seconds. Short by intent:
# long enough to review a licence, short enough that a leaked URL expires.
DOCUMENT_URL_TTL=300

# ---------------------------------------------------------------------------
# Dispatch tuning
# ---------------------------------------------------------------------------
# How far ahead the dispatch board looks, in minutes.
DISPATCH_HORIZON_MIN=180
# Drivers further than this (straight-line miles) are not offered as candidates.
DISPATCH_MAX_MILES=40
